# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voice_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voice_ai

# ------------------------------------------------------------------------------
# LiveKit Server Configuration (Self-Hosted)
# ------------------------------------------------------------------------------
LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ------------------------------------------------------------------------------
# AI Provider Keys (STT, LLM, TTS)
# ------------------------------------------------------------------------------
# OpenAI (Default LLM & fallback STT/TTS)
OPENAI_API_KEY=

# Deepgram (Recommended low-latency STT)
DEEPGRAM_API_KEY=

# Cartesia or ElevenLabs (Low-latency TTS options)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# FastAPI Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# Frontend Application Settings
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_LIVEKIT_URL=ws://localhost:7880
